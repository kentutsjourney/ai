# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_from_botfather"
# Bot username tanpa tanda @ (misal: "TongkronganAIBot")
BOT_USERNAME="your_bot_username"

# Owner Username (khusus yang bisa menggunakan bot di chat pribadi / DM)
OWNER_USERNAME="your_telegram_username"

# Google Gemini API
GEMINI_API_KEY="your_gemini_api_key_here"

# Supabase Configuration
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_or_anon_key"

# Vercel Deployment / Webhook Security (Opsional)
VERCEL_URL="https://your-project.vercel.app"
SECRET_TOKEN="your_random_secret_token_here"
